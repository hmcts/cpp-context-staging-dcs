<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="create-dcs-defendant" author="cpp-context-staging-dcs">
        <createTable tableName="dcs_defendant">
            <column name="defendant_id" type="UUID" >
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="forename" type="VARCHAR(500)"/>
            <column name="middlename" type="VARCHAR(500)"/>
            <column name="surname" type="VARCHAR(500)"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="interpreter_language" type="VARCHAR(500)"/>
            <column name="interpreter_information" type="VARCHAR(500)"/>
            <column name="bail_status" type="VARCHAR(50)"/>
            <column name="organisation_name" type="VARCHAR(500)"/>
            <column name="defence_org_name" type="VARCHAR(500)"/>
            <column name="defence_org_email" type="VARCHAR(500)"/>
            <column name="created_at" type="DATETIME TZ"/>
            <column name="updated_at" type="DATETIME TZ"/>
        </createTable>
    </changeSet>

</databaseChangeLog>